{
  "name": "@dns-markdown/parser",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "downloader": "bash src/dns-markdown-parser/dns_shop_downloader.sh && bun run src/dns-markdown-parser/crawler.ts && bash src/dns-markdown-parser/dns_shop_downloader_prices.sh",
    "add:list": "bun src/add-price-list",
    "add:analysis-report": "bun src/add-report",
    "add:analysis-data:full": "WRITE_STRATEGY=replace bun src/add-analysis-data",
    "add:analysis-data": "WRITE_STRATEGY=insert bun src/add-analysis-data",
    "add:analysis-diff:full": "WRITE_STRATEGY=replace bun src/add-analysis-diff",
    "add:analysis-diff": "WRITE_STRATEGY=insert bun src/add-analysis-diff",
    "add:vector-db": "bun src/add-vector-db",
    "check:favorites": "bun src/check-favorites",
    "cache:clear:local": "KEYS=local:* bun src/cache-clear",
    "cache:clear": "KEYS=daily:* bun src/cache-clear",
    "parse": "bun run downloader && bun run add:list && bun run add:analysis-data && bun run add:analysis-diff && bun run cache:clear",
    "parse:samara": "CITY=samara NODE_ENV=production bun run parse && bun run check:favorites && bun run add:vector-db",
    "parse:moscow": "CITY=moscow  NODE_ENV=production bun run parse",
    "delete:old-price-lists": "CITY=samara bun src/delete-old-price-lists",
    "lint": "eslint src"
  },
  "dependencies": {
    "@dns-markdown/db": "workspace:*",
    "@dns-markdown/env": "workspace:*",
    "@upstash/vector": "^1.2.2",
    "axios": "^1.13.4",
    "cheerio": "^1.1.2",
    "mongodb": "^7.0.0",
    "ora": "^9.3.0",
    "resend": "^6.9.1",
    "zod": "^4.3.6"
  }
}
