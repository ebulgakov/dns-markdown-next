{
  "projectId": "3301003c-46a0-474f-929c-4a00e6ef2718",
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "pkg": "dns-markdown-next",
  "globalName": "DnsMarkdown",
  "entry": ".design-sync/entry.ts",
  "tsconfig": ".design-sync/tsconfig.entry.json",
  "extraEntries": ["./.design-sync/entry.ts"],
  "cssEntry": ".design-sync/tailwind-snapshot.css",
  "buildCmd": "cp .design-sync/sb-reference/assets/iframe-*.css .design-sync/tailwind-snapshot.css  # run AFTER rebuilding sb-reference, BEFORE package-build.mjs — see NOTES.md \"Tailwind CSS missing\"",
  "titleMap": {
    "Navbar": null,
    "Notifications": "ProfileNotifications",
    "Chart": "ChartContainer"
  },
  "overrides": {
    "AnalyticsGoodsChangesChart": { "cardMode": "column" },
    "AnalyticsReports": { "cardMode": "column", "skip": ["components-analytics-analyticsreports--empty-reports"] },
    "Catalog": { "cardMode": "column", "skip": ["components-catalog-catalog--default", "components-catalog-catalog--archive", "components-catalog-catalog--updates", "components-catalog-catalog--with-search", "components-catalog-catalog--with-favorite-sections", "components-catalog-catalog--with-hidden-sections"] },
    "ProductCard": { "cardMode": "column" },
    "Alert": { "cardMode": "column" },
    "JumpToSectionContainer": { "cardMode": "column" },
    "JumpToSection": { "cardMode": "single", "primaryStory": "Default" },
    "Dialog": { "cardMode": "single", "primaryStory": "Default" },
    "SortGoods": { "cardMode": "single", "primaryStory": "Default state" },
    "ChartPrices": { "cardMode": "single" }
  }
}
