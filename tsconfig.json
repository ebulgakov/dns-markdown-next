{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/shared/*": ["./src/shared/*"],
      "@/_pages/home": ["./src/_pages/home"],
      "@/_pages/home/*": ["./src/_pages/home/*"],
      "@/_pages/about": ["./src/_pages/about"],
      "@/_pages/about/*": ["./src/_pages/about/*"],
      "@/_pages/analysis": ["./src/_pages/analysis"],
      "@/_pages/analysis/*": ["./src/_pages/analysis/*"],
      "@/_pages/archive": ["./src/_pages/archive"],
      "@/_pages/archive/*": ["./src/_pages/archive/*"],
      "@/_pages/archive-item": ["./src/_pages/archive-item"],
      "@/_pages/archive-item/*": ["./src/_pages/archive-item/*"],
      "@/_pages/catalog": ["./src/_pages/catalog"],
      "@/_pages/catalog/*": ["./src/_pages/catalog/*"],
      "@/_pages/catalog-item": ["./src/_pages/catalog-item"],
      "@/_pages/catalog-item/*": ["./src/_pages/catalog-item/*"],
      "@/_pages/favorites": ["./src/_pages/favorites"],
      "@/_pages/favorites/*": ["./src/_pages/favorites/*"],
      "@/_pages/profile": ["./src/_pages/profile"],
      "@/_pages/profile/*": ["./src/_pages/profile/*"],
      "@/_pages/today": ["./src/_pages/today"],
      "@/_pages/today/*": ["./src/_pages/today/*"],
      "@/_pages/sign-in": ["./src/_pages/sign-in"],
      "@/_pages/sign-in/*": ["./src/_pages/sign-in/*"],
      "@/_pages/sign-up": ["./src/_pages/sign-up"],
      "@/_pages/sign-up/*": ["./src/_pages/sign-up/*"],
      "@/entities/user": ["./src/entities/user"],
      "@/entities/user/*": ["./src/entities/user/*"],
      "@/entities/product": ["./src/entities/product"],
      "@/entities/product/*": ["./src/entities/product/*"],
      "@/features/favorite-toggle": ["./src/features/favorite-toggle"],
      "@/features/favorite-toggle/*": ["./src/features/favorite-toggle/*"],
      "@/features/product-catalog": ["./src/features/product-catalog"],
      "@/features/product-catalog/*": ["./src/features/product-catalog/*"],
      "@/features/search": ["./src/features/search"],
      "@/features/search/*": ["./src/features/search/*"],
      "@/features/sort-goods": ["./src/features/sort-goods"],
      "@/features/sort-goods/*": ["./src/features/sort-goods/*"],
      "@/features/jump-to-section": ["./src/features/jump-to-section"],
      "@/features/jump-to-section/*": ["./src/features/jump-to-section/*"],
      "@/features/llm-report": ["./src/features/llm-report"],
      "@/features/llm-report/*": ["./src/features/llm-report/*"],
      "@/features/change-city": ["./src/features/change-city"],
      "@/features/change-city/*": ["./src/features/change-city/*"],
      "@/widgets/navbar": ["./src/widgets/navbar"],
      "@/widgets/navbar/*": ["./src/widgets/navbar/*"],
      "@/widgets/footer": ["./src/widgets/footer"],
      "@/widgets/footer/*": ["./src/widgets/footer/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
