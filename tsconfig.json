{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/shared/*": ["./src/shared/*"],
      "@/entities/user": ["./src/entities/user"],
      "@/entities/user/*": ["./src/entities/user/*"],
      "@/entities/product": ["./src/entities/product"],
      "@/entities/product/*": ["./src/entities/product/*"],
      "@/features/product-catalog": ["./src/features/product-catalog"],
      "@/features/product-catalog/*": ["./src/features/product-catalog/*"],
      "@/features/search": ["./src/features/search"],
      "@/features/search/*": ["./src/features/search/*"],
      "@/features/sort-goods": ["./src/features/sort-goods"],
      "@/features/sort-goods/*": ["./src/features/sort-goods/*"],
      "@/features/jump-to-section": ["./src/features/jump-to-section"],
      "@/features/jump-to-section/*": ["./src/features/jump-to-section/*"],
      "@/features/llm-report": ["./src/features/llm-report"],
      "@/features/llm-report/*": ["./src/features/llm-report/*"],
      "@/features/change-city": ["./src/features/change-city"],
      "@/features/change-city/*": ["./src/features/change-city/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
