{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/shared/*": ["./src/shared/*"],
      "@/services/post": ["./src/entities/user/api/post"],
      "@/services/user": ["./src/entities/user/api/user"],
      "@/services/guest": ["./src/entities/user/api/guest"],
      "@/types/user": ["./src/entities/user/model/user"],
      "@/app/contexts/user-context": ["./src/entities/user/model/user-context"],
      "@/services/get": ["./src/entities/product/api/get"],
      "@/types/product": ["./src/entities/product/model/product"],
      "@/types/pricelist": ["./src/entities/product/model/pricelist"],
      "@/app/stores/pricelist-store": ["./src/entities/product/model/pricelist-store"],
      "@/app/components/product-card/*": ["./src/entities/product/ui/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
