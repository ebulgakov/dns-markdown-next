# Shared env for all workspaces. Copy to `.env` (and/or `.env.<NODE_ENV>`) in the repo root.
# Do NOT set CITY here: parser stages must fail without an explicit CITY from their scripts.

# --- Shared: api + parser ---
API_SECRET_KEY=1234567890...
API_SERVICE_KEY=1234567890...
UPSTASH_VECTOR_REST_URL=https://...
UPSTASH_VECTOR_REST_TOKEN=AB2...

# --- apps/api ---
# PORT=4000
DATABASE_URL=mongodb+srv://...
CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
OPENAI_API_KEY=sk-...
CACHE_PREFIX=
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=AX...
CORS_ORIGIN=http://localhost:3000
OTEL_SERVICE_NAME=Dns-Markdown-API
OTEL_EXPORTER_OTLP_ENDPOINT=https://...
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRICS_EXPORTER=

# --- apps/parser (PORT is set by its `start` script) ---
API_URL=https://...
WEB_URL=https://...
WEBHOOK_SECRET_KEY=reval_secret...
RESEND_API_KEY=re_...
