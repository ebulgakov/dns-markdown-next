{
  "name": "dns-markdown",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^17.0.8",
    "nx": "^23.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "scripts": {
    "dev": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t dev",
    "dev:test": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t dev:test",
    "build": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t build",
    "test": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t test",
    "lint": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t lint",
    "lint:fix": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t lint:fix",
    "type-check": "NX_LOAD_DOT_ENV_FILES=false nx run-many -t type-check",
    "affected": "NX_LOAD_DOT_ENV_FILES=false nx affected -t lint type-check test build",
    "prepare": "husky"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "@parcel/watcher",
    "@sentry/cli",
    "@swc/core",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
